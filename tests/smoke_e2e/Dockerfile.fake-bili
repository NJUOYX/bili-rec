# Fake Bilibili as its own container for the smoke test (#19 §4).
# Built FROM the birec image under test: it already carries python, aiohttp,
# brotli and ffmpeg, so nothing extra needs installing — and a fixture of real
# encoded FLV is generated at build time so a remux yields a playable mp4.
ARG BASE_IMAGE=birec:ci
FROM ${BASE_IMAGE}

# 25 minutes of low-bitrate test footage: longer than any smoke run, small
# enough to encode in seconds.
RUN ffmpeg -hide_banner -loglevel error \
    -f lavfi -i testsrc2=duration=1500:rate=25:size=320x240 \
    -f lavfi -i sine=frequency=440:duration=1500 \
    -c:v libx264 -preset ultrafast -pix_fmt yuv420p \
    -c:a aac -b:a 64k \
    -f flv /opt/fixture.flv

COPY tests/system/fake_bili_server.py /opt/fake_bili_server.py

ENV FAKE_BILI_FIXTURE=/opt/fixture.flv \
    FAKE_BILI_PORT=18080 \
    FAKE_BILI_BIND_HOST=0.0.0.0
EXPOSE 18080
ENTRYPOINT ["python", "/opt/fake_bili_server.py"]
